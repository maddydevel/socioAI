# Public address of the app (must be HTTPS in production). Callback URLs are built from it.
BASE_URL=https://follow.example.com
PORT=8787
NODE_ENV=production
# At least 32 random characters. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# X: developer.x.com > Projects & Apps > your app > User authentication settings (OAuth 2.0, Web App)
# Callback URL: ${BASE_URL}/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn: linkedin.com/developers > your app > Products > "Sign In with LinkedIn using OpenID Connect"
# Authorized redirect URL: ${BASE_URL}/auth/li/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Reddit: reddit.com/prefs/apps > create app (type "web app"); API access needs Reddit's approval
# Redirect URI: ${BASE_URL}/auth/rd/callback
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Instagram: developers.facebook.com > your app > Instagram > "API setup with Instagram login"
# Use the Instagram app ID and secret. Valid OAuth redirect URI: ${BASE_URL}/auth/ig/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
