{
  "manifest_version": 3,
  "name": "AI Follow Desk",
  "version": "1.1.0",
  "description": "Your daily AI briefing: updates from 79 AI companies, leaders and researchers, a follow tracker, and posts saved as you browse X, LinkedIn, Instagram and Reddit.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open AI Follow Desk",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.linkedin.com/*",
        "https://www.instagram.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*/ai-follow-desk/*",
        "file:///*/socioAI/*",
        "file:///*/socioai/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "accounts.json"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.linkedin.com/*",
        "https://www.instagram.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://blogs.nvidia.com/*",
    "https://cursor.com/*",
    "https://deepmind.google/*",
    "https://elevenlabs.io/*",
    "https://huggingface.co/*",
    "https://huyenchip.com/*",
    "https://karpathy.bearblog.dev/*",
    "https://lilianweng.github.io/*",
    "https://magazine.sebastianraschka.com/*",
    "https://news.google.com/*",
    "https://newsletter.languagemodels.co/*",
    "https://openai.com/*",
    "https://qwenlm.github.io/*",
    "https://simonwillison.net/*",
    "https://www.oneusefulthing.org/*",
    "https://www.philschmid.de/*",
    "https://www.reddit.com/*",
    "https://www.together.ai/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
